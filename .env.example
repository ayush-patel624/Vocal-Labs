# AI Agent Workflow Builder - Environment Configuration

# LLM Provider: 'gemini', 'groq', 'openrouter', or 'stub' (default)
LLM_PROVIDER=stub

# LLM API Key (required if LLM_PROVIDER is not 'stub')
# For Gemini: https://aistudio.google.com/app/apikey
# For Groq: https://console.groq.com/keys
# For OpenRouter: https://openrouter.ai/keys
LLM_API_KEY=

# Hasura Admin Secret
HASURA_ADMIN_SECRET=myadminsecret

# JWT Secret (must be at least 32 characters)
JWT_SECRET=supersecretkeythatisatleast32charslong!!

# PostgreSQL
POSTGRES_DB=workflow_builder
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
